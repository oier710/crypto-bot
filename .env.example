# Copia este archivo a .env y rellena. .env está en .gitignore y NUNCA se sube.

# ===== Bot on-chain (Uniswap en Arbitrum) — el que usamos =====
# Dirección pública de la cuenta del experimento (empieza por 0x)
WALLET_ADDRESS=
# Clave privada de ESA cuenta (MetaMask > cuenta > Detalles > Mostrar clave privada).
# SOLO la cuenta del experimento, nunca una con más fondos. Con --dry-run no hace falta.
WALLET_PRIVATE_KEY=
# RPC de Arbitrum One (el público funciona; uno gratuito de Alchemy/Infura es más fiable)
ARB_RPC_URL=https://arb1.arbitrum.io/rpc

# ===== Hyperliquid (NO disponible desde EE.UU.; se deja por si cambia) =====
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
HL_NETWORK=testnet

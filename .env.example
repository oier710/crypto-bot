# Copia este archivo a .env y rellena. .env está en .gitignore y NUNCA se sube.
#
# La AGENT WALLET es una clave separada que Hyperliquid te deja crear.
# Solo puede abrir/cerrar operaciones. NO puede retirar ni transferir fondos.
# NO pongas aquí la seed phrase ni la clave privada de tu MetaMask principal.

# Dirección pública de tu cuenta de Hyperliquid (la de MetaMask, empieza por 0x)
HL_ACCOUNT_ADDRESS=

# Clave privada de la AGENT WALLET (no de la cuenta principal)
HL_AGENT_PRIVATE_KEY=

# testnet | mainnet   (empezamos SIEMPRE en testnet)
HL_NETWORK=testnet

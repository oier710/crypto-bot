# Copia este archivo a .env y rellena. .env está en .gitignore y NUNCA se sube.
# Solo hace falta para ejecutar el bot desde el Mac; en producción las claves están
# como secretos del repo en GitHub (Settings > Secrets and variables > Actions).

# Dirección pública de la cuenta del experimento (empieza por 0x)
WALLET_ADDRESS=
# Clave privada de ESA cuenta. SOLO la cuenta del experimento. Con --dry-run no hace falta.
WALLET_PRIVATE_KEY=
# RPC de Arbitrum One (el público funciona)
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
